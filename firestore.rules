rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Imagen: una generada por la app (/api/images/...) siempre debe declararse como generada con IA.
    function validImage(img) {
      return img == null || (img is map && img.url is string && img.url.size() <= 2000
        && img.origin in ['propia', 'licencia_libre', 'archivo', 'generada_ia', 'alterada_ia']
        && (!img.url.matches('^/api/images/.*') || img.origin == 'generada_ia'));
    }

    // Forma minima de una noticia escrita desde el portal. Un documento mal formado tumbaria el feed.
    function validArticle(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.summary is string && d.summary.size() <= 600
        && d.body is string && d.body.size() <= 20000
        && d.topics is list && d.topics.size() >= 1 && d.topics.size() <= 12
        && d.scope in ['local', 'nacional', 'regional', 'internacional']
        && d.places is list && d.places.size() <= 10
        && d.sources is list && d.sources.size() >= 1 && d.sources.size() <= 10
        && d.verification in ['confirmada', 'en_desarrollo']
        && d.publishedAt is number
        && (!('image' in d) || validImage(d.image));
    }

    // Noticia nueva de un usuario sin rol: solo campos conocidos, firmada con su propio uid
    // y sin fecha en el futuro (no puede fijarse arriba del feed).
    function ownNewArticle(d) {
      return d.keys().hasOnly(['title', 'summary', 'summaryOrigin', 'body', 'topics', 'scope', 'places',
          'sources', 'verification', 'image', 'publishedAt', 'authorUid'])
        && d.authorUid == request.auth.uid
        && (!('summaryOrigin' in d) || d.summaryOrigin in ['humano', 'ia'])
        && d.publishedAt <= request.time.toMillis() + 60000;
    }

    // Noticias: cualquier usuario autenticado lee y puede publicar (crear) noticias.
    // Editar y borrar sigue siendo solo de admin.
    match /articles/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validArticle(request.resource.data)
        && (isAdmin() || ownNewArticle(request.resource.data));
      allow update: if isAdmin() && validArticle(request.resource.data);
      allow delete: if isAdmin();
    }

    // Campos que el cliente puede escribir en su perfil, con tipo y tamano acotados.
    function validProfileFields(d) {
      return (!('locationId' in d) || (d.locationId is string && d.locationId.size() <= 40))
        && (!('topicAffinity' in d) || (d.topicAffinity is map && d.topicAffinity.size() <= 40));
    }

    // Perfil: cada quien el suyo. Nadie puede asignarse ni cambiar su propio rol
    // (el rol admin se pone a mano en la consola de Firebase).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['locationId', 'topicAffinity'])
        && validProfileFields(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locationId', 'topicAffinity'])
        && validProfileFields(request.resource.data);
    }

    // Senales de comportamiento: solo las propias, con forma fija y un documento por usuario y
    // noticia (id = uid_articleId), asi la coleccion no crece sin limite.
    match /events/{eventId} {
      allow create, update: if signedIn()
        && eventId == request.auth.uid + '_' + request.resource.data.articleId
        && request.resource.data.keys().hasOnly(['uid', 'articleId', 'type', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'abrir'
        && request.resource.data.articleId is string && request.resource.data.articleId.size() <= 128
        && request.resource.data.ts is number;
    }

    // aiUsage, meta/budget, chatLimits e images: solo el servidor (Admin SDK). Todo lo demas, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
