# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.
# Sin ningun valor, la app corre en modo demo (datos de ejemplo, sin Firebase ni IA).

# --- Firebase cliente (publicas por diseno) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase servidor (SECRETO): JSON de la cuenta de servicio en una linea o en base64 ---
FIREBASE_SERVICE_ACCOUNT=

# --- Chat con IA: Anthropic Claude (SECRETO) ---
# Vacio = el chat responde en modo extractivo, sin gastar.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# USD por 1M de tokens del modelo de arriba (claude-haiku-4-5: 1 entrada, 5 salida)
AI_PRICE_IN=1
AI_PRICE_OUT=5

# --- Imagenes con IA: OpenRouter (SECRETO, opcional) ---
# Vacio = el portal solo ofrece la busqueda de imagenes con licencia (Openverse, gratis).
# Crear una llave solo para esta app con "Credit limit" en OpenRouter.
OPENROUTER_API_KEY=
# Modelo mas barato: openai/gpt-image-1-mini (calidad baja). Alternativa: recraft/recraft-v4.1-flash
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1-mini
# Estimado por imagen que muestra el portal. El gasto registrado es el costo real que devuelve OpenRouter.
AI_IMAGE_ESTIMATE_USD=0.005
# Clave para firmar las URLs de las imagenes generadas (cualquier texto largo y aleatorio).
# Si se omite se deriva de FIREBASE_SERVICE_ACCOUNT; si esa cuenta cambia, las imagenes viejas dejan de cargar.
IMAGE_URL_SECRET=

# --- Presupuesto y limites ---
# 1 = apaga toda llamada a IA (chat e imagenes)
AI_MOCK=0
# Tope de gasto en USD (de 20 totales; la diferencia queda de reserva para la demo)
AI_BUDGET_CAP_USD=14
# Preguntas con IA por usuario al dia, y rafaga maxima por minuto
CHAT_DAILY_LIMIT=30
CHAT_BURST_PER_MIN=10
# Zona horaria para reiniciar el cupo diario
APP_TIMEZONE=America/Guatemala

# Solo para `next start` local sin Firebase: permite el modo demo en el servidor.
# En produccion debe quedar vacio (sin cuenta de servicio, la API rechaza todo).
ALLOW_DEMO_SERVER=
