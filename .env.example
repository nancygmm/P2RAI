# Este archivo se copia a .env.local. Sin estas variables la app corre en MODO DEMO
# (datos de ejemplo locales, sin Firebase y sin gastar creditos de IA).

# --- Firebase cliente (Consola Firebase > Configuracion del proyecto > Tus apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase servidor: JSON de la cuenta de servicio en UNA linea (o en base64) ---
FIREBASE_SERVICE_ACCOUNT=

# --- IA (OpenAI). Sin llave, o con AI_MOCK=1, el chat responde sin llamar al modelo ---
OPENAI_API_KEY=
# El identificador y el precio se confirman en el panel de OpenAI (gpt-5.6-luna o gpt-6-luna).
OPENAI_MODEL=gpt-5.6-luna
# Precio en USD por 1M de tokens; se usa para calcular el gasto registrado.
AI_PRICE_IN=0.20
AI_PRICE_OUT=1.20
AI_MOCK=1

# --- Presupuesto ---
# Tope de gasto en USD: al alcanzarlo la IA se apaga (quedan 20 - tope como reserva).
AI_BUDGET_CAP_USD=14
# Preguntas de chat por usuario al dia.
CHAT_DAILY_LIMIT=30
